# --- Banco de dados (Neon Postgres) ---
# Use a connection string "pooled" do Neon para a aplicação (runtime).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/pcm?sslmode=require"
# Use a connection string DIRETA (sem pooler) do Neon para migrations.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/pcm?sslmode=require"
# Limites do pool WebSocket do Neon por processo. connection_limit e
# connect_timeout presentes diretamente na DATABASE_URL vencem.
DATABASE_CONNECTION_LIMIT="5"
DATABASE_CONNECT_TIMEOUT_SECONDS="10"

# --- Auth.js ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Integração com o serviço de IA (FastAPI) ---
# Localmente, use as URLs abaixo. No Vercel Services, NÃO cadastre estas duas
# variáveis no painel: o binding PREDICTIVE_AI_INTERNAL_URL do vercel.json
# injeta a URL interna correta para cada deployment de Preview e Production.
PREDICTIVE_AI_URL="http://localhost:8000"
# Deve ser IGUAL à AI_SERVICE_API_KEY em services/predictive-ai/.env
AI_SERVICE_API_KEY="change-me-in-local-env"

# --- Gateway de IA térmica (GPMS 2026 / Etapa 5) ---
# Aponta para o FastAPI térmico da Etapa 8. Readiness só fica ativa com
# bundle, metadados, feature version, estágio e checksum válidos.
# AI_SERVICE_URL tem precedência sobre PREDICTIVE_AI_URL. Localmente, mantenha
# ambas iguais para não apontar integrações a hosts distintos.
AI_SERVICE_URL="http://localhost:8000"
AI_REQUEST_TIMEOUT_MS="30000"
AI_MAX_RETRIES="5"
# Pinagem OPCIONAL — quando definidas, restringem ainda mais o conjunto já
# fixo em código (SYNTHETIC_EXPERIMENTAL/PLANT_CALIBRATION/PLANT_VALIDATED);
# nunca o ampliam. Não existe variável capaz de habilitar DEMO/RULE_ONLY.
EXPECTED_MODEL_STAGE=""
EXPECTED_MODEL_CHECKSUM=""

# --- Simulador de dados sintéticos (/thermal-readings/simulator) ---
# Desabilitado por padrão: a rota fica indisponível e o link some da tela de
# leituras, mesmo para quem tem a permissão thermal-reading:simulate. Ligue
# só em ambiente de desenvolvimento/demonstração.
ENABLE_THERMAL_SIMULATOR="false"

# --- Único cron diário (/api/cron/daily-maintenance) ---
# Reconcilia OS preventivas, fila térmica e retenção do log técnico. O
# processamento contínuo normal usa Vercel Queues, não este cron.
CRON_SECRET="generate-with-openssl-rand-base64-32"

# --- Telemetria contínua e worker durável (Etapa 9) ---
TELEMETRY_MAX_BATCH_SIZE="100"
TELEMETRY_MAX_PAYLOAD_BYTES="262144"
TELEMETRY_MAX_CLOCK_SKEW_SECONDS="300"
TELEMETRY_MAX_DELAY_DAYS="30"
TELEMETRY_RATE_LIMIT_PER_MINUTE="60"
TELEMETRY_AUDIT_RETENTION_DAYS="90"
DEVICE_OFFLINE_MULTIPLIER="3"
# Segredo exclusivo do endpoint interno de reconciliação/worker. Não é a
# chave de nenhum dispositivo e não deve ser exposto ao navegador.
TELEMETRY_WORKER_SECRET="generate-with-openssl-rand-base64-32"
