FROM python:3.12-slim AS trainer

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /workspace/services/predictive-ai

COPY services/predictive-ai/requirements.vercel-build.txt ./requirements.vercel-build.txt
COPY services/predictive-ai/requirements.vercel-runtime.txt ./requirements.vercel-runtime.txt
RUN pip install --no-cache-dir -r requirements.vercel-build.txt

# O artefato .joblib não é versionado. O contexto do serviço é a raiz do
# monorepo para que o build reproduza o modelo a partir dos datasets oficiais.
COPY services/predictive-ai /workspace/services/predictive-ai
COPY datasets/processed /workspace/datasets/processed
COPY datasets/demo /workspace/datasets/demo
COPY datasets/metadata /workspace/datasets/metadata
COPY datasets/reports /workspace/datasets/reports

# Nunca publica uma imagem sem bundle, metadados e checksum válidos.
RUN python -m training.train_thermal_models \
    && python -m training.validate_model_artifact

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    APP_ENV=production

WORKDIR /app

COPY services/predictive-ai/requirements.vercel-runtime.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY --from=trainer /workspace/services/predictive-ai/app ./app
COPY --from=trainer /workspace/services/predictive-ai/models ./models

# Containers Vercel usam 80 por padrão e podem injetar PORT no projeto.
CMD exec uvicorn app.main:app --host 0.0.0.0 --port "${PORT:-80}"
