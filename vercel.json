{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "functions": {
        "src/app/api/queues/thermal-analysis/route.ts": {
          "maxDuration": 60,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "thermal-analysis",
              "retryAfterSeconds": 5,
              "initialDelaySeconds": 0
            }
          ]
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "predictive_ai",
          "format": "url",
          "env": "PREDICTIVE_AI_INTERNAL_URL"
        }
      ]
    },
    "predictive_ai": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/telemetry/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "predictive_ai"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "predictive_ai"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-maintenance",
      "schedule": "0 6 * * *"
    }
  ]
}
