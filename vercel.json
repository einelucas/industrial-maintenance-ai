{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "predictive_ai",
          "format": "url",
          "env": "AI_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "predictive_ai",
          "format": "url",
          "env": "PREDICTIVE_AI_URL"
        }
      ]
    },
    "predictive_ai": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "predictive_ai"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "predictive_ai"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-maintenance",
      "schedule": "0 6 * * *"
    }
  ]
}
