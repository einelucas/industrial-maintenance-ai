# Ambiente de execução: development | production
APP_ENV=development

# Bundle e metadados térmicos da Etapa 8. Ausência, corrupção ou divergência
# de checksum deixa /api/v1/thermal/health indisponível; não existe fallback.
THERMAL_MODEL_PATH=models/thermal_model.joblib
THERMAL_MODEL_METADATA_PATH=models/metadata.json

# Chave usada para autenticar chamadas backend-to-backend vindas do Next.js.
# Deve ser igual à AI_SERVICE_API_KEY definida em apps/web/.env.
# NUNCA versionar o valor real.
AI_SERVICE_API_KEY=change-me-in-local-env

# Origem permitida (apenas para debug local via Swagger, não expõe o serviço ao browser em produção)
CORS_ORIGINS=http://localhost:3000

# Nas imagens Docker comum e Vercel o bundle é treinado e validado durante o
# build a partir dos datasets processados. Em execução local, use os mesmos
# comandos do README.
